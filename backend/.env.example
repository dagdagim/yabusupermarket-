# Production Environment Variables Template
PORT=5000
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas or Hosted MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/yabusupermarket?retryWrites=true&w=majority

# JWT Secrets (generate strong random strings)
JWT_SECRET=super_secret_production_jwt_key_min_32_characters_long
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=super_secret_production_refresh_jwt_key_min_32_chars
JWT_REFRESH_EXPIRE=30d

# Client URL (Web domain or app scheme)
CLIENT_URL=*
